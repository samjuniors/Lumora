rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isHardcodedAdmin() {
      return isSignedIn() && (request.auth.token.email == 'luvkus8@gmail.com');
    }
    
    function isSuperAdmin() { 
      return isSignedIn() && 
        (isHardcodedAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') == 'superadmin')); 
    }
    function isAtLeastAdmin() {
      return isSignedIn() && 
        (isHardcodedAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in ['admin', 'superadmin']));
    }
    function isAdmin() { return isAtLeastAdmin(); }

    match /recharge_requests/{requestId} {
      allow get: if isSignedIn() && (isAtLeastAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAtLeastAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid && isValidId(requestId);
      allow update: if isAtLeastAdmin();
      allow delete: if isAtLeastAdmin();
    }

    match /inviteCodes/{codeId} {
        allow read: if isSignedIn();
        allow create: if isAtLeastAdmin() && isValidId(codeId);
        allow update: if (isAtLeastAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy', 'currentUses', 'maxUses', 'updatedAt'])) ||
                         (isSignedIn() && existing().used == false && incoming().usedBy is list && incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy', 'currentUses', 'updatedAt']));
        allow delete: if isAtLeastAdmin();
    }

    match /assignment_templates/{templateId} {
        allow read: if isSignedIn();
        allow create: if isAtLeastAdmin() && isValidId(templateId);
        allow update: if isAtLeastAdmin();
        allow delete: if isAtLeastAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSuperAdmin()) || (
        isSignedIn() && request.auth.uid == userId && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt', 'avatar', 'bannerColor', 'theme'])) ||
          (incoming().diff(existing()).affectedKeys().hasAny(['streak', 'lastActive', 'coins', 'diamonds', 'taxWallet', 'xp', 'inventory', 'lastRewardClaimed', 'xpBoosterUntil', 'totalScore', 'gradedCount', 'lastMissedSweep', 'achievements', 'badgesClaimed', 'updatedAt']) && 
           !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email', 'createdAt']))
        )
      ) || (
        isAtLeastAdmin() && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email', 'createdAt'])
      );
      allow delete: if isSuperAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isAtLeastAdmin() && isValidId(assignmentId);
      allow update: if isAtLeastAdmin() || isSuperAdmin();
      allow delete: if isAtLeastAdmin();
    }

    match /pre_registered_users/{pId} {
      allow read: if isSignedIn();
      allow create: if isAtLeastAdmin();
      allow update: if isAtLeastAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedAt', 'userId']));
      allow delete: if isAtLeastAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAtLeastAdmin());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAtLeastAdmin());
      allow create: if isSignedIn() && (incoming().studentId == request.auth.uid || isAtLeastAdmin()) && isValidId(enrollmentId);
      allow update: if isAtLeastAdmin() || (
          existing().studentId == request.auth.uid && (
            (incoming().diff(existing()).affectedKeys().hasAny(['status', 'rewardEarned', 'updatedAt', 'graceDeadline']) && 
             !incoming().diff(existing()).affectedKeys().hasAny(['studentId', 'assignmentId', 'id', 'enrolledAt']))
          )
      );
      allow delete: if isAtLeastAdmin();
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAtLeastAdmin() || resource.data.status == 'assessed');
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAtLeastAdmin() || resource.data.status == 'assessed');
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid && isValidId(submissionId);
      allow update: if isAtLeastAdmin() || (
          existing().studentId == request.auth.uid && existing().status in ['pending', 'assessed'] && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'attachments', 'updatedAt', 'aiScore', 'aiFeedback', 'status'])
      );
      allow delete: if isSignedIn() && (existing().studentId == request.auth.uid || isAtLeastAdmin());
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAtLeastAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAtLeastAdmin());
      allow create: if isAtLeastAdmin() || (
        isSignedIn() && isValidId(transactionId) && 
        (incoming().senderId == request.auth.uid || (incoming().senderId == 'SYSTEM' && incoming().receiverId == request.auth.uid))
      );
      allow update: if isAtLeastAdmin();
      allow delete: if isAtLeastAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAtLeastAdmin());
      allow create: if isSignedIn() && isValidId(notificationId);
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) || isAtLeastAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAtLeastAdmin();
    }

    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isAtLeastAdmin();
      allow update: if isAtLeastAdmin();
      allow delete: if isAtLeastAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
