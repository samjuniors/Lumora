// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
  superadmin
}

model User {
  id               String   @id
  email            String   @unique
  name             String
  role             Role     @default(student)
  coins            Int      @default(0)
  diamonds         Int      @default(0)
  
  // Profile metadata
  avatar           String?
  bio              String?
  bannerColor      String?
  theme            String?
  themeId          String?
  
  // Stats
  xp               Int      @default(0)
  level            Int      @default(1)
  rank             Int?
  streak           Int      @default(0)
  
  // Cooldowns
  lastRewardClaimedAt DateTime?
  lastCollectionAt     DateTime?
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastActive       DateTime?
  
  // Optional relations IDs without full relations yet to keep it minimal
  syndicateId      String?
  luminaId         String?

  // Social
  followingIds     String[]
  followerIds      String[]
  presence         String   @default("offline")

  @@index([role])
}

model Notification {
  id               String   @id
  userId           String
  title            String
  message          String   @db.Text
  type             String
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
  
  @@index([userId])
}

model InviteCode {
  id               String   @id
  code             String   @unique
  role             String
  createdBy        String
  used             Boolean  @default(false)
  usedBy           String[]
  maxUses          Int?
  currentUses      Int?     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([code])
}

model Settings {
  id               String   @id @default("global")
  upiHandle        String?
  mobileNumber     String?
  payeeName        String?
  paymentLink      String?
  updatedAt        DateTime @updatedAt
}

model Enrollment {
  id               String   @id
  assignmentId     String
  studentId        String
  enrolledAt       DateTime @default(now())
  status           String   @default("active")
  grade            Int?
  rewardEarned     Int?
  graceDeadline    DateTime?
  isDoubleDown     Boolean? @default(false)
  stakedAmount     Int?
  updatedAt        DateTime @updatedAt

  @@index([assignmentId])
  @@index([studentId])
}

model Transaction {
  id               String   @id
  senderId         String
  receiverId       String
  amount           Int
  currency         String   @default("coins")
  type             String
  status           String   @default("completed")
  utr              String?
  itemId           String?
  message          String?  @db.Text
  timestamp        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([type])
}

model Assignment {
  id               String   @id
  title            String
  description      String   @db.Text
  dueDate          String
  points           Int      @default(0)
  status           String   @default("draft")
  createdBy        String?
  createdAt        String?
  hasAiFeedback    Boolean? @default(false)
  requireUpload    Boolean? @default(false)
  allowedFileTypes String[]
  difficulty       String?
  category         String?
  timeLimit        Int?
  maxAttempts      Int?

  @@index([status])
}

model Submission {
  id               String   @id
  assignmentId     String
  studentId        String
  content          String   @db.Text
  attachments      Json?    // Optional Array of Attachment objects
  aiScore          Int?
  aiFeedback       String?  @db.Text
  feedback         Json?    
  calculatedReward Int?
  penaltyAmount    Int?
  status           String   @default("pending")
  tabSwitches      Int?     @default(0)
  pasteCount       Int?     @default(0)
  submittedAt      String?
  updatedAt        String?

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
}

model RechargeRequest {
  id        String   @id
  userId    String
  amount    Int
  currency  String   @default("INR")
  status    String   @default("pending")
  utr       String?
  timestamp DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Syndicate {
  id          String   @id
  name        String
  motto       String?
  emblem      String?
  leaderId    String
  members     String[] 
  score       Int      @default(0)
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([leaderId])
}

model AssignmentTemplate {
  id               String   @id
  title            String
  description      String   @db.Text
  defaultPoints    Int      @default(0)
  difficulty       String?
  category         String?
  allowedFileTypes String[]
  hasAiFeedback    Boolean? @default(false)
  requireUpload    Boolean? @default(false)
  tags             String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PreRegisteredUser {
  id        String   @id // Usually email if email is key
  email     String   @unique
  name      String?
  role      String   @default("student")
  coins     Int      @default(100)
  status    String   @default("pending") // pending, claimed
  claimedAt DateTime?
  userId    String?  // The ID of the created user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

