// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
  superadmin
}

model User {
  id               String   @id
  email            String   @unique
  name             String
  role             Role     @default(student)
  coins            Int      @default(0)
  diamonds         Int      @default(10) // Small starting bonus
  
  // Profile metadata
  avatar           String?
  bio              String?
  bannerColor      String?
  theme            String?
  themeId          String?
  
  // Stats
  xp               Int      @default(0)
  level            Int      @default(1)
  rank             Int?
  streak           Int      @default(0)
  
  // AI Pet Stats
  petFullness      Int      @default(100)
  petHappiness     Int      @default(100)
  petLastFed       DateTime @default(now())

  // Cooldowns
  lastRewardClaimedAt DateTime?
  lastCollectionAt     DateTime?
  nextDailyRewardAt    DateTime?
  nextCollectionAt     DateTime?
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastActive       DateTime?
  
  // Optional relations IDs without full relations yet to keep it minimal
  syndicateId      String?
  syndicate        Syndicate? @relation("SyndicateMembers", fields: [syndicateId], references: [id])
  luminaId         String?

  // Social
  followingIds     String[]
  followerIds      String[]
  presence         String   @default("offline")

  academicRoadmap  String?  @db.Text

  // Missing fields synchronized from types.ts
  taxWallet             Int      @default(0)
  rechargedCoins        Int      @default(0)
  inviteCodeUsed        String?
  achievements          String[]
  badgesClaimed         String[]
  inventory             String[]
  lastMissedSweep       Float?
  lastSeenVersion       String?
  lifetimeDiamonds      Int      @default(0)
  dailyDiamonds         Int      @default(0)
  weeklyDiamonds        Int      @default(0)
  lastResetDay          String?
  lastResetWeek         String?
  xpBoosterUntil        Float?
  vipExp                Int      @default(0)
  vipLevel              Int      @default(0)
  isOracleUnlocked      Boolean  @default(false)
  taxHavenUntil         Float?
  doubleDownShieldUntil Float?
  badgeIds              String[]
  totalScore            Int      @default(0)
  gradedCount           Int      @default(0)

  @@index([role])
}

model Notification {
  id               String   @id
  userId           String
  title            String
  message          String   @db.Text
  type             String
  read             Boolean  @default(false)
  metadata         Json?    // For navigation payload like { url: '/assignments/123' }
  createdAt        DateTime @default(now())
  
  @@index([userId])
}

model InviteCode {
  id               String   @id
  code             String   @unique
  role             String
  createdBy        String
  used             Boolean  @default(false)
  usedBy           String[]
  maxUses          Int?
  currentUses      Int?     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([code])
}

model Settings {
  id               String   @id @default("global")
  upiHandle        String?
  mobileNumber     String?
  payeeName        String?
  paymentLink      String?
  updatedAt        DateTime @updatedAt
}

model Enrollment {
  id               String   @id
  assignmentId     String
  studentId        String
  enrolledAt       DateTime @default(now())
  status           String   @default("active")
  grade            Int?
  rewardEarned     Int?
  graceDeadline    DateTime?
  isDoubleDown     Boolean? @default(false)
  stakedAmount     Int?
  updatedAt        DateTime @updatedAt

  @@index([assignmentId])
  @@index([studentId])
}

model Transaction {
  id               String   @id
  senderId         String
  receiverId       String
  amount           Int
  currency         String   @default("coins")
  type             String
  status           String   @default("completed")
  utr              String?
  itemId           String?
  message          String?  @db.Text
  timestamp        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([type])
}

model Assignment {
  id               String   @id
  title            String
  description      String   @db.Text
  instructions     String?  @db.Text
  rubric           Json?
  subject          String?
  frequency        String?
  startDate        Float?
  timeLimitMinutes Int?
  dueDate          Float
  entryFee         Int      @default(0)
  bonusReward      Int      @default(0)
  penaltyFee       Int      @default(0)
  xpReward         Int      @default(0)
  isBonus          Boolean  @default(false)
  isDuoBonus       Boolean? @default(false)
  duoId            String?
  bonusType        String?
  missionNumber    Int?
  allowedStudents  String[]
  isGlobal         Boolean? @default(false)
  status           String   @default("active")
  campaignId       String?
  creatorId        String
  gradedCount      Int?     @default(0)
  totalScore       Int?     @default(0)
  createdAt        Float
  updatedAt        Float

  @@index([status])
  @@index([creatorId])
}

model Submission {
  id               String   @id
  assignmentId     String
  studentId        String
  content          String   @db.Text
  attachments      Json?    // Optional Array of Attachment objects
  aiScore          Int?
  aiFeedback       String?  @db.Text
  feedback         Json?    
  calculatedReward Int?
  penaltyAmount    Int?
  status           String   @default("pending")
  tabSwitches      Int?     @default(0)
  pasteCount       Int?     @default(0)
  submittedAt      String?
  updatedAt        String?

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
}

model RechargeRequest {
  id        String   @id
  userId    String
  amount    Int
  currency  String   @default("INR")
  status    String   @default("pending")
  utr       String?
  timestamp DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Syndicate {
  id          String   @id
  name        String
  description String   @default("") @db.Text
  tag         String   @default("")
  leaderId    String
  memberIds   String[] 
  totalScore  Int      @default(0)
  coinsStaked Int      @default(0)
  logo        String?
  level       Int      @default(1)
  createdAt   Float    @default(0)
  updatedAt   Float    @default(0)
  
  users       User[]   @relation("SyndicateMembers")

  @@index([leaderId])
}

model AssignmentTemplate {
  id               String   @id
  label            String   @default("")
  title            String
  subject          String   @default("")
  description      String   @db.Text
  instructions     String   @default("") @db.Text
  timeLimitMinutes Int      @default(0)
  rubric           Json?
  creatorId        String?
  createdAt        Float?
}

model PreRegisteredUser {
  id        String   @id // Usually email if email is key
  email     String   @unique
  name      String?
  role      String   @default("student")
  coins     Int      @default(100)
  status    String   @default("pending") // pending, claimed
  claimedAt DateTime?
  userId    String?  // The ID of the created user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId])
}


