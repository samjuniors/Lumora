// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
  superadmin
}

model User {
  id               String   @id
  email            String   @unique
  name             String
  role             Role     @default(student)
  coins            Int      @default(0)
  diamonds         Int      @default(0)
  
  // Profile metadata
  avatar           String?
  bio              String?
  bannerColor      String?
  theme            String?
  themeId          String?
  
  // Stats
  xp               Int      @default(0)
  level            Int      @default(1)
  rank             Int?
  streak           Int      @default(0)
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastActive       DateTime?
  
  // Optional relations IDs without full relations yet to keep it minimal
  syndicateId      String?
  luminaId         String?
}

model Assignment {
  id               String   @id
  title            String
  description      String   @db.Text
  dueDate          String
  points           Int      @default(0)
  status           String   @default("draft")
  createdBy        String?
  createdAt        String?
  hasAiFeedback    Boolean? @default(false)
  requireUpload    Boolean? @default(false)
  allowedFileTypes String[]
  difficulty       String?
  category         String?
  timeLimit        Int?
  maxAttempts      Int?
}

model Submission {
  id               String   @id
  assignmentId     String
  studentId        String
  content          String   @db.Text
  attachments      Json?    // Optional Array of Attachment objects
  aiScore          Int?
  aiFeedback       String?  @db.Text
  feedback         Json?    
  calculatedReward Int?
  penaltyAmount    Int?
  status           String   @default("pending")
  tabSwitches      Int?     @default(0)
  pasteCount       Int?     @default(0)
  submittedAt      String?
  updatedAt        String?
}

